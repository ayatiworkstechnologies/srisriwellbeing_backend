APP_NAME=Sri Sri Wellbeing API
APP_VERSION=1.0.0
APP_ENV=staging
DEBUG=false
SQL_ECHO=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/srisri_wellbeing_staging
JWT_SECRET_KEY=replace-with-a-long-random-staging-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
ALLOWED_ORIGINS=https://staging.example.com
